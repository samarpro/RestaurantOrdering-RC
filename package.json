{
  "name": "restaurant-order-processor",
  "version": "0.1.0",
  "private": true,
  "description": "A restaurant ordering service with web and command-line interfaces.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "npm run check && npm run build:css",
    "build:css": "npx @tailwindcss/cli -i ./src/web/styles.css -o ./public/assets/styles.css --minify",
    "check": "tsc --noEmit",
    "dev": "node --watch src/server.ts",
    "dev:css": "npx @tailwindcss/cli -i ./src/web/styles.css -o ./public/assets/styles.css --watch",
    "start": "node src/server.ts",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
